{
  "//": "Cases every Treebars SDK runs against its own implementation, shared so that the SDKs cannot disagree. Generated; do not edit.",
  "epoch_ms": 1700000000000,
  "policy": {
    "debounce_ms": 1000,
    "spacing_ms": 5000,
    "spacing_metered_ms": 15000,
    "spacing_test_ms": 1000,
    "spacing_constrained_ms": 30000,
    "spacing_min_ms": 1000,
    "spacing_max_ms": 60000,
    "batch_size": 50
  },
  "scenarios": [
    {
      "id": "FP-001",
      "rule": "debounce",
      "name": "an event on a quiet device is sent a second after it happens, and not a moment before",
      "steps": [
        {
          "do": "track",
          "at": 0,
          "events": [
            "e1"
          ]
        },
        {
          "do": "advance",
          "at": 999,
          "expect": {
            "sent": []
          }
        },
        {
          "do": "advance",
          "at": 1000,
          "responses": [
            {
              "status": 200
            }
          ],
          "expect": {
            "sent": [
              {
                "events": [
                  "e1"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "FP-002",
      "rule": "debounce",
      "name": "a burst is one upload: the wait is armed by the first event and not moved by later ones",
      "steps": [
        {
          "do": "track",
          "at": 0,
          "events": [
            "e1"
          ]
        },
        {
